# Copy to .env locally if you prefer — never commit real keys.
# Codebase also reads these from the process environment.

# openrouter | ollama
CODEBASE_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional override for data root (default: ~/.codebase)
# CODEBASE_HOME=

# CODEBASE_VERBOSE=1
